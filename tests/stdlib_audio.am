// Stdlib test: Amalgame.Audio — synth + transform + WAV IO.
// Deterministic: synthesis is pure, WAV round-trip is lossless.
// Audio.Play is NOT tested (silent CI machines have no usable
// output device). The submarine_ping.am sample covers playback.

namespace Tests

import Amalgame.Audio

public class Program {
    public static void Main(string[] args) {

        let sr: int = 44100

        // ── 1. GenSine — sample count matches duration × sr ───
        let sine = Audio.GenSine(440.0, 0.1, sr)   // 100 ms A4
        if (sine.Count() == 4410) {
            Console.WriteLine("[PASS] GenSine length")
        } else {
            Console.WriteLine("[FAIL] GenSine length got "
                + String_FromInt(sine.Count()))
        }

        // ── 2. GenSilence — same length, all zeros ────────────
        let sil = Audio.GenSilence(0.1, sr)
        if (sil.Count() == 4410 && sil.Get(0) == 0 && sil.Get(2200) == 0) {
            Console.WriteLine("[PASS] GenSilence is silent")
        } else {
            Console.WriteLine("[FAIL] GenSilence got Get(0)="
                + String_FromInt(sil.Get(0)))
        }

        // ── 3. Sine extremum is near int16 max ────────────────
        // For a pure sine at 440 Hz / 44100 Hz, the first sample's
        // peak is in the first ~25 samples. Scan for the max abs.
        let n: int = sine.Count()
        var peak: int = 0
        var i: int = 0
        while (i < n) {
            let v: int = sine.Get(i)
            let a: int = v
            if (a < 0) { i = i + 1; continue }
            if (a > peak) { peak = a }
            i = i + 1
        }
        // Expect ~32760 (int16_max - rounding); allow some slack.
        if (peak > 32000 && peak <= 32767) {
            Console.WriteLine("[PASS] sine peak ~int16 max ("
                + String_FromInt(peak) + ")")
        } else {
            Console.WriteLine("[FAIL] sine peak got "
                + String_FromInt(peak))
        }

        // ── 4. Envelope — first sample is ~0 (attack ramp) ────
        let shaped = Audio.ApplyEnvelope(sine, 10.0, 10.0, sr)
        let first: int = shaped.Get(0)
        if (first == 0) {
            Console.WriteLine("[PASS] envelope first sample = 0")
        } else {
            Console.WriteLine("[FAIL] envelope first sample = "
                + String_FromInt(first))
        }

        // ── 5. Scale 0.5 halves the magnitudes (sample 1000) ──
        let half = Audio.Scale(sine, 0.5)
        let s1: int = sine.Get(1000)
        let s2: int = half.Get(1000)
        let diff: int = (s1 / 2) - s2
        // Allow ±1 for rounding — compute |diff| via a var, then
        // single bounds check. Amalgame's parser is picky about
        // `>= a - b && c` chains, so we sidestep with a fold.
        var absDiff: int = diff
        if (absDiff < 0) { absDiff = 0 - absDiff }
        if (absDiff <= 1) {
            Console.WriteLine("[PASS] Scale 0.5 halves sample 1000")
        } else {
            Console.WriteLine("[FAIL] Scale: s1=" + String_FromInt(s1)
                + " s2=" + String_FromInt(s2) + " diff=" + String_FromInt(diff))
        }


        // ── 6. Mix — overlay silence offset 0 is identity ─────
        let mix1 = Audio.Mix(sine, sil, 0)
        let lenOk: bool   = mix1.Count() == sine.Count()
        let valOk: bool   = mix1.Get(500) == sine.Get(500)
        if (lenOk && valOk) {
            Console.WriteLine("[PASS] Mix with silence is identity")
        } else {
            Console.WriteLine("[FAIL] Mix vs silence diverged at 500")
        }

        // ── 7. Echo — output length matches formula ───────────
        // Length = len(samples) + repeats * (delayMs * sr / 1000)
        let echoed = Audio.Echo(sine, 100.0, 0.5, 3, sr)
        let expect = 4410 + 3 * 4410   // 100ms at 44100 = 4410
        if (echoed.Count() == expect) {
            Console.WriteLine("[PASS] Echo length matches formula")
        } else {
            Console.WriteLine("[FAIL] Echo length got "
                + String_FromInt(echoed.Count())
                + " expected " + String_FromInt(expect))
        }

        // ── 8. SaveAsWav + LoadWav round-trip ────────────────
        let path: string = "/tmp/amc_audio_test.wav"
        let ok: bool = Audio.SaveAsWav(sine, sr, path)
        if (ok) {
            Console.WriteLine("[PASS] SaveAsWav")
        } else {
            Console.WriteLine("[FAIL] SaveAsWav: " + Audio.LastError())
            return
        }
        let back = Audio.LoadWav(path)
        if (back.Count() == sine.Count()) {
            Console.WriteLine("[PASS] LoadWav length round-trip")
        } else {
            Console.WriteLine("[FAIL] LoadWav got "
                + String_FromInt(back.Count())
                + " expected " + String_FromInt(sine.Count()))
        }
        // Sample-exact equality across WAV round-trip (int16 PCM is lossless)
        let exact1: bool = back.Get(100)  == sine.Get(100)
        let exact2: bool = back.Get(2000) == sine.Get(2000)
        if (exact1 && exact2) {
            Console.WriteLine("[PASS] WAV round-trip sample-exact")
        } else {
            Console.WriteLine("[FAIL] WAV round-trip sample diverged")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.2 — sondes + format-agnostic Load
        // ═══════════════════════════════════════════════════════

        // ── 9. SampleRateOf reads back the rate we saved ──────
        let rateBack: int = Audio.SampleRateOf(path)
        if (rateBack == sr) {
            Console.WriteLine("[PASS] SampleRateOf returns " + String_FromInt(sr))
        } else {
            Console.WriteLine("[FAIL] SampleRateOf got "
                + String_FromInt(rateBack))
        }

        // ── 10. ChannelCountOf — mono = 1 ─────────────────────
        let chBack: int = Audio.ChannelCountOf(path)
        if (chBack == 1) {
            Console.WriteLine("[PASS] ChannelCountOf returns 1 for mono WAV")
        } else {
            Console.WriteLine("[FAIL] ChannelCountOf got "
                + String_FromInt(chBack))
        }

        // ── 11. DurationMsOf — 0.1s × 44100 = 100ms ───────────
        let durMs: int = Audio.DurationMsOf(path)
        if (durMs == 100) {
            Console.WriteLine("[PASS] DurationMsOf returns 100 for 0.1s sine")
        } else {
            Console.WriteLine("[FAIL] DurationMsOf got "
                + String_FromInt(durMs))
        }

        // ── 12. Load (format-agnostic) ────────────────────────
        let agnostic = Audio.Load(path)
        if (agnostic.Count() == sine.Count()) {
            Console.WriteLine("[PASS] Load auto-detects WAV")
        } else {
            Console.WriteLine("[FAIL] Load got "
                + String_FromInt(agnostic.Count()))
        }

        // ── 13. Probes on missing file return 0 (error path) ──
        let bogus: int = Audio.SampleRateOf("/tmp/does_not_exist.wav")
        if (bogus == 0) {
            Console.WriteLine("[PASS] SampleRateOf rejects missing file")
        } else {
            Console.WriteLine("[FAIL] SampleRateOf got "
                + String_FromInt(bogus))
        }

        // ═══════════════════════════════════════════════════════
        //  v0.3 — mic capture
        // ═══════════════════════════════════════════════════════
        //
        // Probe for a default capture device by running a tiny
        // blocking Record. On headless CI machines this returns an
        // empty buffer + sets LastError — every downstream capture
        // assertion then SKIPs instead of FAILs.
        //
        // We use 50 ms at 16 kHz = 800 samples for the probe — fast
        // enough not to slow the suite, long enough to exercise the
        // callback's write path on real hardware.

        let probe = Audio.Record(0.05, 16000)
        let probeN: int = probe.Count()
        let haveCapture: bool = (probeN == 800)

        // ── 14. Record blocking — length matches duration × rate ──
        if (haveCapture) {
            Console.WriteLine("[PASS] Record blocking length")
        } else {
            Console.WriteLine("[SKIP] Record blocking (no capture device)")
        }

        // ── 15. Non-blocking Start → IsActive → Stop trio ────
        if (haveCapture) {
            let h = Audio.RecordStart(1.0, 16000)
            let active1: bool = Audio.RecordIsActive(h)
            let cap1 = Audio.RecordStop(h)
            // active1 must be true (started, not stopped yet).
            // Buffer count is non-negative by construction.
            // NB: don't touch h after RecordStop — it's freed.
            if (active1 && cap1.Count() >= 0) {
                Console.WriteLine("[PASS] RecordStart/Stop handle roundtrip")
            } else {
                Console.WriteLine("[FAIL] RecordStart/Stop got "
                    + String_FromInt(cap1.Count()))
            }
        } else {
            Console.WriteLine("[SKIP] RecordStart/Stop (no capture device)")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.4 — streaming playback (Pause / Resume / Stop)
        // ═══════════════════════════════════════════════════════
        //
        // Probe for a default playback device by starting a tiny
        // silence stream. PlayStart returns null on headless CI
        // machines (no default output device) — every downstream
        // streaming assertion then SKIPs.
        //
        // We use 1 second of silence at 16 kHz so the buffer is
        // long enough that PlayIsActive stays true while we run
        // the state-machine assertions (PlayPause → PlayResume).

        let silentBuf = Audio.GenSilence(1.0, 16000)
        let probeH = Audio.PlayStart(silentBuf, 16000)
        // AM lacks a syntax for "is this pointer null" on opaque
        // handles — we lean on PlayIsActive which returns false
        // when the handle is null AND when the buffer is drained.
        // On a fresh PlayStart against a real device with 1 s of
        // silence at 16 kHz, the cursor advances by at most a few
        // hundred samples before this check fires, so active is
        // true. On a headless box, PlayStart returns null and
        // PlayIsActive yields false → SKIP.
        let havePlayback: bool = Audio.PlayIsActive(probeH)

        // ── 16. PlayStart on a real device leaves handle active ─
        if (havePlayback) {
            Console.WriteLine("[PASS] PlayStart returns active handle")
        } else {
            Console.WriteLine("[SKIP] PlayStart (no playback device)")
        }

        // ── 17. Pause → IsPaused true, Resume → IsPaused false ──
        if (havePlayback) {
            Audio.PlayPause(probeH)
            let p1: bool = Audio.PlayIsPaused(probeH)
            Audio.PlayResume(probeH)
            let p2: bool = Audio.PlayIsPaused(probeH)
            if (p1 && !p2) {
                Console.WriteLine("[PASS] PlayPause/Resume toggles flag")
            } else {
                Console.WriteLine("[FAIL] PlayPause/Resume: p1="
                    + String_FromInt(p1) + " p2=" + String_FromInt(p2))
            }
        } else {
            Console.WriteLine("[SKIP] PlayPause/Resume (no playback device)")
        }

        // ── 18. PlayStop returns true + frees handle ──────────
        if (havePlayback) {
            let stopped: bool = Audio.PlayStop(probeH)
            if (stopped) {
                Console.WriteLine("[PASS] PlayStop returns true on live handle")
            } else {
                Console.WriteLine("[FAIL] PlayStop returned false")
            }
        } else {
            Console.WriteLine("[SKIP] PlayStop (no playback device)")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.5 — live AudioMixer (multi-source streaming)
        // ═══════════════════════════════════════════════════════
        //
        // We reuse the same playback-device probe — if PlayStart
        // succeeded on the silence buffer above, mixer tests run
        // against the real device. If not, they SKIP.
        //
        // Tests cover: MixerStart success, AddSource returns a
        // positive voice id, SourceCount reflects the live count,
        // RemoveSource decrements it, and MixerStop succeeds.
        // We don't sleep / wait for natural drain — the assertions
        // are pure state-machine, audible by the user but not
        // gated on timing.

        if (havePlayback) {
            let m = Audio.MixerStart(16000)
            // MixerStart returns null on no-device — but we
            // already probed with PlayStart, so here it should
            // succeed. Use MixerSourceCount as a non-throwing
            // null-aware probe (returns 0 on null mixer too).
            let initialCount: int = Audio.MixerSourceCount(m)
            if (initialCount == 0) {
                Console.WriteLine("[PASS] MixerStart fresh mixer has 0 sources")
            } else {
                Console.WriteLine("[FAIL] MixerStart fresh count = "
                    + String_FromInt(initialCount))
            }

            // ── 19. AddSource × 2, expect 2 alive ─────────────
            let tone1 = Audio.GenSine(440.0, 0.5, 16000)
            let tone2 = Audio.GenSine(550.0, 0.5, 16000)
            let v1: int = Audio.MixerAddSource(m, tone1, 0.5, false)
            let v2: int = Audio.MixerAddSource(m, tone2, 0.5, false)
            let cnt2: int = Audio.MixerSourceCount(m)
            // v1, v2 are monotonic voice ids starting at 1; cnt2
            // should be 2 (both alive on a freshly-started mixer).
            if (v1 > 0 && v2 > v1 && cnt2 == 2) {
                Console.WriteLine("[PASS] MixerAddSource × 2 → 2 voices")
            } else {
                Console.WriteLine("[FAIL] MixerAddSource: v1=" + String_FromInt(v1)
                    + " v2=" + String_FromInt(v2) + " cnt=" + String_FromInt(cnt2))
            }

            // ── 20. SetGain / SetPaused on a live voice ───────
            let gainOk: bool = Audio.MixerSetGain(m, v1, 0.8)
            let pauseOk: bool = Audio.MixerSetPaused(m, v2, true)
            if (gainOk && pauseOk) {
                Console.WriteLine("[PASS] MixerSetGain/SetPaused on live voices")
            } else {
                Console.WriteLine("[FAIL] MixerSetGain="
                    + String_FromInt(gainOk) + " SetPaused="
                    + String_FromInt(pauseOk))
            }

            // ── 21. RemoveSource decrements SourceCount ───────
            let rmOk: bool = Audio.MixerRemoveSource(m, v1)
            let cnt1: int = Audio.MixerSourceCount(m)
            if (rmOk && cnt1 == 1) {
                Console.WriteLine("[PASS] MixerRemoveSource decrements count")
            } else {
                Console.WriteLine("[FAIL] MixerRemoveSource: ok="
                    + String_FromInt(rmOk) + " cnt=" + String_FromInt(cnt1))
            }

            // ── 22. SetGain on stale voice id returns false ───
            let staleOk: bool = Audio.MixerSetGain(m, v1, 0.5)
            if (!staleOk) {
                Console.WriteLine("[PASS] MixerSetGain on stale voice id is false")
            } else {
                Console.WriteLine("[FAIL] MixerSetGain on stale id returned true")
            }

            // ── 23. MixerStop returns true + frees ────────────
            let mstop: bool = Audio.MixerStop(m)
            if (mstop) {
                Console.WriteLine("[PASS] MixerStop returns true")
            } else {
                Console.WriteLine("[FAIL] MixerStop returned false")
            }
        } else {
            Console.WriteLine("[SKIP] MixerStart fresh mixer (no playback device)")
            Console.WriteLine("[SKIP] MixerAddSource × 2 (no playback device)")
            Console.WriteLine("[SKIP] MixerSetGain/SetPaused (no playback device)")
            Console.WriteLine("[SKIP] MixerRemoveSource (no playback device)")
            Console.WriteLine("[SKIP] MixerSetGain stale id (no playback device)")
            Console.WriteLine("[SKIP] MixerStop (no playback device)")
        }
    }
}
