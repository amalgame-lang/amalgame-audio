// Stdlib test: Amalgame.Audio — synth + transform + WAV IO.
// Deterministic: synthesis is pure, WAV round-trip is lossless.
// Audio.Play is NOT tested (silent CI machines have no usable
// output device). The submarine_ping.am sample covers playback.

namespace Tests

import Amalgame.Audio

public class Program {
    public static void Main(string[] args) {

        let sr: int = 44100

        // ── 1. GenSine — sample count matches duration × sr ───
        let sine = Audio.GenSine(440.0, 0.1, sr)   // 100 ms A4
        if (sine.Count() == 4410) {
            Console.WriteLine("[PASS] GenSine length")
        } else {
            Console.WriteLine("[FAIL] GenSine length got "
                + String_FromInt(sine.Count()))
        }

        // ── 2. GenSilence — same length, all zeros ────────────
        let sil = Audio.GenSilence(0.1, sr)
        if (sil.Count() == 4410 && sil.Get(0) == 0 && sil.Get(2200) == 0) {
            Console.WriteLine("[PASS] GenSilence is silent")
        } else {
            Console.WriteLine("[FAIL] GenSilence got Get(0)="
                + String_FromInt(sil.Get(0)))
        }

        // ── 3. Sine extremum is near int16 max ────────────────
        // For a pure sine at 440 Hz / 44100 Hz, the first sample's
        // peak is in the first ~25 samples. Scan for the max abs.
        let n: int = sine.Count()
        var peak: int = 0
        var i: int = 0
        while (i < n) {
            let v: int = sine.Get(i)
            let a: int = v
            if (a < 0) { i = i + 1; continue }
            if (a > peak) { peak = a }
            i = i + 1
        }
        // Expect ~32760 (int16_max - rounding); allow some slack.
        if (peak > 32000 && peak <= 32767) {
            Console.WriteLine("[PASS] sine peak ~int16 max ("
                + String_FromInt(peak) + ")")
        } else {
            Console.WriteLine("[FAIL] sine peak got "
                + String_FromInt(peak))
        }

        // ── 4. Envelope — first sample is ~0 (attack ramp) ────
        let shaped = Audio.ApplyEnvelope(sine, 10.0, 10.0, sr)
        let first: int = shaped.Get(0)
        if (first == 0) {
            Console.WriteLine("[PASS] envelope first sample = 0")
        } else {
            Console.WriteLine("[FAIL] envelope first sample = "
                + String_FromInt(first))
        }

        // ── 5. Scale 0.5 halves the magnitudes (sample 1000) ──
        let half = Audio.Scale(sine, 0.5)
        let s1: int = sine.Get(1000)
        let s2: int = half.Get(1000)
        let diff: int = (s1 / 2) - s2
        // Allow ±1 for rounding — compute |diff| via a var, then
        // single bounds check. Amalgame's parser is picky about
        // `>= a - b && c` chains, so we sidestep with a fold.
        var absDiff: int = diff
        if (absDiff < 0) { absDiff = 0 - absDiff }
        if (absDiff <= 1) {
            Console.WriteLine("[PASS] Scale 0.5 halves sample 1000")
        } else {
            Console.WriteLine("[FAIL] Scale: s1=" + String_FromInt(s1)
                + " s2=" + String_FromInt(s2) + " diff=" + String_FromInt(diff))
        }


        // ── 6. Mix — overlay silence offset 0 is identity ─────
        let mix1 = Audio.Mix(sine, sil, 0)
        let lenOk: bool   = mix1.Count() == sine.Count()
        let valOk: bool   = mix1.Get(500) == sine.Get(500)
        if (lenOk && valOk) {
            Console.WriteLine("[PASS] Mix with silence is identity")
        } else {
            Console.WriteLine("[FAIL] Mix vs silence diverged at 500")
        }

        // ── 7. Echo — output length matches formula ───────────
        // Length = len(samples) + repeats * (delayMs * sr / 1000)
        let echoed = Audio.Echo(sine, 100.0, 0.5, 3, sr)
        let expect = 4410 + 3 * 4410   // 100ms at 44100 = 4410
        if (echoed.Count() == expect) {
            Console.WriteLine("[PASS] Echo length matches formula")
        } else {
            Console.WriteLine("[FAIL] Echo length got "
                + String_FromInt(echoed.Count())
                + " expected " + String_FromInt(expect))
        }

        // ── 8. SaveAsWav + LoadWav round-trip ────────────────
        let path: string = "/tmp/amc_audio_test.wav"
        let ok: bool = Audio.SaveAsWav(sine, sr, path)
        if (ok) {
            Console.WriteLine("[PASS] SaveAsWav")
        } else {
            Console.WriteLine("[FAIL] SaveAsWav: " + Audio.LastError())
            return
        }
        let back = Audio.LoadWav(path)
        if (back.Count() == sine.Count()) {
            Console.WriteLine("[PASS] LoadWav length round-trip")
        } else {
            Console.WriteLine("[FAIL] LoadWav got "
                + String_FromInt(back.Count())
                + " expected " + String_FromInt(sine.Count()))
        }
        // Sample-exact equality across WAV round-trip (int16 PCM is lossless)
        let exact1: bool = back.Get(100)  == sine.Get(100)
        let exact2: bool = back.Get(2000) == sine.Get(2000)
        if (exact1 && exact2) {
            Console.WriteLine("[PASS] WAV round-trip sample-exact")
        } else {
            Console.WriteLine("[FAIL] WAV round-trip sample diverged")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.2 — sondes + format-agnostic Load
        // ═══════════════════════════════════════════════════════

        // ── 9. SampleRateOf reads back the rate we saved ──────
        let rateBack: int = Audio.SampleRateOf(path)
        if (rateBack == sr) {
            Console.WriteLine("[PASS] SampleRateOf returns " + String_FromInt(sr))
        } else {
            Console.WriteLine("[FAIL] SampleRateOf got "
                + String_FromInt(rateBack))
        }

        // ── 10. ChannelCountOf — mono = 1 ─────────────────────
        let chBack: int = Audio.ChannelCountOf(path)
        if (chBack == 1) {
            Console.WriteLine("[PASS] ChannelCountOf returns 1 for mono WAV")
        } else {
            Console.WriteLine("[FAIL] ChannelCountOf got "
                + String_FromInt(chBack))
        }

        // ── 11. DurationMsOf — 0.1s × 44100 = 100ms ───────────
        let durMs: int = Audio.DurationMsOf(path)
        if (durMs == 100) {
            Console.WriteLine("[PASS] DurationMsOf returns 100 for 0.1s sine")
        } else {
            Console.WriteLine("[FAIL] DurationMsOf got "
                + String_FromInt(durMs))
        }

        // ── 12. Load (format-agnostic) ────────────────────────
        let agnostic = Audio.Load(path)
        if (agnostic.Count() == sine.Count()) {
            Console.WriteLine("[PASS] Load auto-detects WAV")
        } else {
            Console.WriteLine("[FAIL] Load got "
                + String_FromInt(agnostic.Count()))
        }

        // ── 13. Probes on missing file return 0 (error path) ──
        let bogus: int = Audio.SampleRateOf("/tmp/does_not_exist.wav")
        if (bogus == 0) {
            Console.WriteLine("[PASS] SampleRateOf rejects missing file")
        } else {
            Console.WriteLine("[FAIL] SampleRateOf got "
                + String_FromInt(bogus))
        }

        // ═══════════════════════════════════════════════════════
        //  v0.3 — mic capture
        // ═══════════════════════════════════════════════════════
        //
        // Probe for a default capture device by running a tiny
        // blocking Record. On headless CI machines this returns an
        // empty buffer + sets LastError — every downstream capture
        // assertion then SKIPs instead of FAILs.
        //
        // We use 50 ms at 16 kHz = 800 samples for the probe — fast
        // enough not to slow the suite, long enough to exercise the
        // callback's write path on real hardware.

        let probe = Audio.Record(0.05, 16000)
        let probeN: int = probe.Count()
        let haveCapture: bool = (probeN == 800)

        // ── 14. Record blocking — length matches duration × rate ──
        if (haveCapture) {
            Console.WriteLine("[PASS] Record blocking length")
        } else {
            Console.WriteLine("[SKIP] Record blocking (no capture device)")
        }

        // ── 15. Non-blocking Start → IsActive → Stop trio ────
        if (haveCapture) {
            let h = Audio.RecordStart(1.0, 16000)
            let active1: bool = Audio.RecordIsActive(h)
            let cap1 = Audio.RecordStop(h)
            // active1 must be true (started, not stopped yet).
            // Buffer count is non-negative by construction.
            // NB: don't touch h after RecordStop — it's freed.
            if (active1 && cap1.Count() >= 0) {
                Console.WriteLine("[PASS] RecordStart/Stop handle roundtrip")
            } else {
                Console.WriteLine("[FAIL] RecordStart/Stop got "
                    + String_FromInt(cap1.Count()))
            }
        } else {
            Console.WriteLine("[SKIP] RecordStart/Stop (no capture device)")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.4 — streaming playback (Pause / Resume / Stop)
        // ═══════════════════════════════════════════════════════
        //
        // Probe for a default playback device by starting a tiny
        // silence stream. PlayStart returns null on headless CI
        // machines (no default output device) — every downstream
        // streaming assertion then SKIPs.
        //
        // We use 1 second of silence at 16 kHz so the buffer is
        // long enough that PlayIsActive stays true while we run
        // the state-machine assertions (PlayPause → PlayResume).

        let silentBuf = Audio.GenSilence(1.0, 16000)
        let probeH = Audio.PlayStart(silentBuf, 16000)
        // AM lacks a syntax for "is this pointer null" on opaque
        // handles — we lean on PlayIsActive which returns false
        // when the handle is null AND when the buffer is drained.
        // On a fresh PlayStart against a real device with 1 s of
        // silence at 16 kHz, the cursor advances by at most a few
        // hundred samples before this check fires, so active is
        // true. On a headless box, PlayStart returns null and
        // PlayIsActive yields false → SKIP.
        let havePlayback: bool = Audio.PlayIsActive(probeH)

        // ── 16. PlayStart on a real device leaves handle active ─
        if (havePlayback) {
            Console.WriteLine("[PASS] PlayStart returns active handle")
        } else {
            Console.WriteLine("[SKIP] PlayStart (no playback device)")
        }

        // ── 17. Pause → IsPaused true, Resume → IsPaused false ──
        if (havePlayback) {
            Audio.PlayPause(probeH)
            let p1: bool = Audio.PlayIsPaused(probeH)
            Audio.PlayResume(probeH)
            let p2: bool = Audio.PlayIsPaused(probeH)
            if (p1 && !p2) {
                Console.WriteLine("[PASS] PlayPause/Resume toggles flag")
            } else {
                Console.WriteLine("[FAIL] PlayPause/Resume: p1="
                    + String_FromInt(p1) + " p2=" + String_FromInt(p2))
            }
        } else {
            Console.WriteLine("[SKIP] PlayPause/Resume (no playback device)")
        }

        // ── 18. PlayStop returns true + frees handle ──────────
        if (havePlayback) {
            let stopped: bool = Audio.PlayStop(probeH)
            if (stopped) {
                Console.WriteLine("[PASS] PlayStop returns true on live handle")
            } else {
                Console.WriteLine("[FAIL] PlayStop returned false")
            }
        } else {
            Console.WriteLine("[SKIP] PlayStop (no playback device)")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.5 — live AudioMixer (multi-source streaming)
        // ═══════════════════════════════════════════════════════
        //
        // We reuse the same playback-device probe — if PlayStart
        // succeeded on the silence buffer above, mixer tests run
        // against the real device. If not, they SKIP.
        //
        // Tests cover: MixerStart success, AddSource returns a
        // positive voice id, SourceCount reflects the live count,
        // RemoveSource decrements it, and MixerStop succeeds.
        // We don't sleep / wait for natural drain — the assertions
        // are pure state-machine, audible by the user but not
        // gated on timing.

        if (havePlayback) {
            let m = Audio.MixerStart(16000)
            // MixerStart returns null on no-device — but we
            // already probed with PlayStart, so here it should
            // succeed. Use MixerSourceCount as a non-throwing
            // null-aware probe (returns 0 on null mixer too).
            let initialCount: int = Audio.MixerSourceCount(m)
            if (initialCount == 0) {
                Console.WriteLine("[PASS] MixerStart fresh mixer has 0 sources")
            } else {
                Console.WriteLine("[FAIL] MixerStart fresh count = "
                    + String_FromInt(initialCount))
            }

            // ── 19. AddSource × 2, expect 2 alive ─────────────
            let tone1 = Audio.GenSine(440.0, 0.5, 16000)
            let tone2 = Audio.GenSine(550.0, 0.5, 16000)
            let v1: int = Audio.MixerAddSource(m, tone1, 0.5, false)
            let v2: int = Audio.MixerAddSource(m, tone2, 0.5, false)
            let cnt2: int = Audio.MixerSourceCount(m)
            // v1, v2 are monotonic voice ids starting at 1; cnt2
            // should be 2 (both alive on a freshly-started mixer).
            if (v1 > 0 && v2 > v1 && cnt2 == 2) {
                Console.WriteLine("[PASS] MixerAddSource × 2 → 2 voices")
            } else {
                Console.WriteLine("[FAIL] MixerAddSource: v1=" + String_FromInt(v1)
                    + " v2=" + String_FromInt(v2) + " cnt=" + String_FromInt(cnt2))
            }

            // ── 20. SetGain / SetPaused on a live voice ───────
            let gainOk: bool = Audio.MixerSetGain(m, v1, 0.8)
            let pauseOk: bool = Audio.MixerSetPaused(m, v2, true)
            if (gainOk && pauseOk) {
                Console.WriteLine("[PASS] MixerSetGain/SetPaused on live voices")
            } else {
                Console.WriteLine("[FAIL] MixerSetGain="
                    + String_FromInt(gainOk) + " SetPaused="
                    + String_FromInt(pauseOk))
            }

            // ── 21. RemoveSource decrements SourceCount ───────
            let rmOk: bool = Audio.MixerRemoveSource(m, v1)
            let cnt1: int = Audio.MixerSourceCount(m)
            if (rmOk && cnt1 == 1) {
                Console.WriteLine("[PASS] MixerRemoveSource decrements count")
            } else {
                Console.WriteLine("[FAIL] MixerRemoveSource: ok="
                    + String_FromInt(rmOk) + " cnt=" + String_FromInt(cnt1))
            }

            // ── 22. SetGain on stale voice id returns false ───
            let staleOk: bool = Audio.MixerSetGain(m, v1, 0.5)
            if (!staleOk) {
                Console.WriteLine("[PASS] MixerSetGain on stale voice id is false")
            } else {
                Console.WriteLine("[FAIL] MixerSetGain on stale id returned true")
            }

            // ── 23. MixerStop returns true + frees ────────────
            let mstop: bool = Audio.MixerStop(m)
            if (mstop) {
                Console.WriteLine("[PASS] MixerStop returns true")
            } else {
                Console.WriteLine("[FAIL] MixerStop returned false")
            }
        } else {
            Console.WriteLine("[SKIP] MixerStart fresh mixer (no playback device)")
            Console.WriteLine("[SKIP] MixerAddSource × 2 (no playback device)")
            Console.WriteLine("[SKIP] MixerSetGain/SetPaused (no playback device)")
            Console.WriteLine("[SKIP] MixerRemoveSource (no playback device)")
            Console.WriteLine("[SKIP] MixerSetGain stale id (no playback device)")
            Console.WriteLine("[SKIP] MixerStop (no playback device)")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.6 — MIDI (SMF IO + render-to-audio)
        // ═══════════════════════════════════════════════════════
        //
        // MIDI tests don't touch any device, so they run on every
        // machine (no SKIP gating needed). We build a small event
        // stream in-memory, save as SMF, load it back, verify the
        // round-trip preserves structure, then render to audio.

        // ── 24. SaveSmf produces a valid file ────────────────
        // Build a tiny stream: middle C (note 60) at velocity 100
        // for one quarter (480 ticks), then E (note 64), then G
        // (note 67) — a C-major arpeggio over 1.44 s at 120 BPM.
        // Packed as quads (delta, status, data1, data2):
        // MIDI status bytes as decimal (AM has no hex literals):
        //   144 = 0x90 = NoteOn  channel 0
        //   128 = 0x80 = NoteOff channel 0
        //   255 = 0xFF = Meta-event
        //    81 = 0x51 = SetTempo meta-type
        let evs = new List<int>()
        // NoteOn C, delta=0
        evs.Add(0); evs.Add(144); evs.Add(60); evs.Add(100)
        // NoteOff C, delta=480 (1 quarter)
        evs.Add(480); evs.Add(128); evs.Add(60); evs.Add(0)
        // NoteOn E, delta=0
        evs.Add(0); evs.Add(144); evs.Add(64); evs.Add(100)
        // NoteOff E
        evs.Add(480); evs.Add(128); evs.Add(64); evs.Add(0)
        // NoteOn G
        evs.Add(0); evs.Add(144); evs.Add(67); evs.Add(100)
        // NoteOff G
        evs.Add(480); evs.Add(128); evs.Add(67); evs.Add(0)

        let smfPath: string = "/tmp/amc_audio_test.mid"
        let savedSmf: bool = Audio.MidiSaveSmf(smfPath, evs, 480, 500000)
        if (savedSmf) {
            Console.WriteLine("[PASS] MidiSaveSmf round-trip writer")
        } else {
            Console.WriteLine("[FAIL] MidiSaveSmf: " + Audio.LastError())
        }

        // ── 25. LoadSmf reads back the same event count ──────
        let backEvs = Audio.MidiLoadSmf(smfPath)
        // We wrote 6 events × 4 ints = 24 quads. The loader
        // returns the same event stream — no extra events except
        // the tempo meta we prepended on save (which becomes the
        // first quad with status=0xFF, data1=0x51).
        // So expected count = 24 (our events) + 4 (the tempo
        // meta) = 28.
        if (backEvs.Count() == 28) {
            Console.WriteLine("[PASS] MidiLoadSmf 28 ints (6 notes + tempo meta)")
        } else {
            Console.WriteLine("[FAIL] MidiLoadSmf got " + String_FromInt(backEvs.Count())
                + " ints (expected 28)")
        }

        // ── 26. MidiLastTempo + TicksPerQuarter ──────────────
        let tpqBack: int = Audio.MidiLastTicksPerQuarter()
        let tempoBack: int = Audio.MidiLastTempo()
        if (tpqBack == 480 && tempoBack == 500000) {
            Console.WriteLine("[PASS] MidiLast* sondes return saved values")
        } else {
            Console.WriteLine("[FAIL] MidiLast*: tpq=" + String_FromInt(tpqBack)
                + " tempo=" + String_FromInt(tempoBack))
        }

        // ── 27. First quad of loaded events is the tempo meta ─
        // Layout: status at offset 1 should be 0xFF (255).
        let firstStatus: int = backEvs.Get(1)
        let firstD1: int = backEvs.Get(2)
        let firstD2: int = backEvs.Get(3)
        if (firstStatus == 255 && firstD1 == 81 && firstD2 == 500000) {
            Console.WriteLine("[PASS] First event is tempo meta (FF 51 500000)")
        } else {
            Console.WriteLine("[FAIL] First event: " + String_FromInt(firstStatus)
                + " " + String_FromInt(firstD1) + " " + String_FromInt(firstD2))
        }

        // ── 28. RenderToAudio produces non-empty mono int16 buffer ─
        // Three quarters at 120 BPM at 44.1kHz = ~1.5 s × 44100 ≈
        // 66150 samples. v0.7 adds a 30 ms release tail flush at
        // end-of-stream, so the upper bound becomes ~67500.
        let rendered = Audio.MidiRenderToAudio(backEvs, 480, 500000, 44100)
        let rN: int = rendered.Count()
        if (rN > 60000 && rN < 80000) {
            Console.WriteLine("[PASS] MidiRenderToAudio length in range")
        } else {
            Console.WriteLine("[FAIL] MidiRenderToAudio length = "
                + String_FromInt(rN) + " (expected ~66150 + release tail)")
        }

        // ── 29. Rendered audio contains non-zero samples ─────
        // Scan a window past the 5 ms attack ramp (220 samples
        // at 44.1 kHz). A NoteOn on note 60 at vel 100 should
        // produce audible peaks well within 5000 samples.
        var foundAudio: bool = false
        var k: int = 250
        let scanEnd: int = 5000
        while (k < scanEnd && k < rN) {
            let sv: int = rendered.Get(k)
            if (sv > 100 || sv < -100) {
                foundAudio = true
                k = scanEnd
            }
            k = k + 1
        }
        if (foundAudio) {
            Console.WriteLine("[PASS] MidiRenderToAudio produces audio")
        } else {
            Console.WriteLine("[FAIL] MidiRenderToAudio output is silent")
        }

        // ── 29b. Attack envelope ramps from ~0 ───────────────
        // First sample should be near silence (attack envelope
        // is 5 ms — at sample 0 the gain factor is 0.0). v0.6
        // would have started immediately at full velocity =>
        // ~6500 magnitude. v0.7 should start near 0.
        let firstSample: int = rendered.Get(0)
        var firstAbs: int = firstSample
        if (firstAbs < 0) { firstAbs = 0 - firstAbs }
        if (firstAbs < 100) {
            Console.WriteLine("[PASS] Attack envelope: first sample near 0")
        } else {
            Console.WriteLine("[FAIL] Attack envelope: first sample = "
                + String_FromInt(firstSample))
        }

        // ── 30. Rendered audio survives SaveAsWav round-trip ─
        let wavPath: string = "/tmp/amc_midi_render_test.wav"
        let midiWavOk: bool = Audio.SaveAsWav(rendered, 44100, wavPath)
        if (midiWavOk) {
            let dur: int = Audio.DurationMsOf(wavPath)
            // Expected ~1500 ms for 3 quarters at 120 BPM.
            if (dur > 1200 && dur < 1800) {
                Console.WriteLine("[PASS] MIDI→audio→WAV round-trip ~1.5s")
            } else {
                Console.WriteLine("[FAIL] MIDI→WAV duration = "
                    + String_FromInt(dur) + " ms")
            }
        } else {
            Console.WriteLine("[FAIL] MIDI→WAV save failed: " + Audio.LastError())
        }

        // ── 31. LoadSmf on missing file returns empty + error ─
        let missing = Audio.MidiLoadSmf("/tmp/does_not_exist.mid")
        if (missing.Count() == 0) {
            Console.WriteLine("[PASS] MidiLoadSmf rejects missing file")
        } else {
            Console.WriteLine("[FAIL] MidiLoadSmf missing file returned "
                + String_FromInt(missing.Count()) + " ints")
        }

        // ═══════════════════════════════════════════════════════
        //  v0.7 — stereo helpers
        // ═══════════════════════════════════════════════════════
        //
        // Pure data-pipeline tests, no device deps.

        // ── 32. MonoToStereo doubles the count, L=R ──────────
        let monoTest = Audio.GenSine(440.0, 0.1, 44100)   // 4410 samples
        let stereoTest = Audio.MonoToStereo(monoTest)
        // Stereo: every mono sample appears twice (interleaved).
        // Count should be 2 × 4410 = 8820.
        if (stereoTest.Count() == 8820) {
            Console.WriteLine("[PASS] MonoToStereo doubles count")
        } else {
            Console.WriteLine("[FAIL] MonoToStereo count = "
                + String_FromInt(stereoTest.Count()))
        }

        // ── 33. MonoToStereo: L sample == R sample at same frame ─
        let mL: int = stereoTest.Get(200)        // L of frame 100
        let mR: int = stereoTest.Get(201)        // R of frame 100
        let mO: int = monoTest.Get(100)
        if (mL == mO && mR == mO) {
            Console.WriteLine("[PASS] MonoToStereo: L == R == mono source")
        } else {
            Console.WriteLine("[FAIL] L=" + String_FromInt(mL)
                + " R=" + String_FromInt(mR)
                + " mono=" + String_FromInt(mO))
        }

        // ── 34. StereoToMono(MonoToStereo(x)) == x (round-trip) ─
        let backMono = Audio.StereoToMono(stereoTest)
        let lenOk2: bool = backMono.Count() == monoTest.Count()
        let val0: bool = backMono.Get(500) == monoTest.Get(500)
        let val1: bool = backMono.Get(2000) == monoTest.Get(2000)
        if (lenOk2 && val0 && val1) {
            Console.WriteLine("[PASS] Stereo→Mono round-trip preserves samples")
        } else {
            Console.WriteLine("[FAIL] Mono round-trip diverged")
        }

        // ── 35. SaveAsWavStereo + LoadWavStereo round-trip ────
        let stPath: string = "/tmp/amc_audio_stereo_test.wav"
        let stOk: bool = Audio.SaveAsWavStereo(stereoTest, 44100, stPath)
        if (stOk) {
            Console.WriteLine("[PASS] SaveAsWavStereo")
        } else {
            Console.WriteLine("[FAIL] SaveAsWavStereo: " + Audio.LastError())
        }
        let stBack = Audio.LoadWavStereo(stPath)
        if (stBack.Count() == stereoTest.Count()) {
            Console.WriteLine("[PASS] LoadWavStereo length round-trip")
        } else {
            Console.WriteLine("[FAIL] LoadWavStereo got "
                + String_FromInt(stBack.Count())
                + " expected " + String_FromInt(stereoTest.Count()))
        }

        // ── 36. Stereo WAV reports 2 channels via ChannelCountOf ─
        let stCh: int = Audio.ChannelCountOf(stPath)
        if (stCh == 2) {
            Console.WriteLine("[PASS] Stereo WAV has 2 channels")
        } else {
            Console.WriteLine("[FAIL] Stereo WAV ChannelCountOf = "
                + String_FromInt(stCh))
        }

        // ── 37. StereoToMono rejects odd-length input ────────
        let badStereo = new List<int>()
        badStereo.Add(100); badStereo.Add(200); badStereo.Add(300)   // 3 ints
        let badMono = Audio.StereoToMono(badStereo)
        if (badMono.Count() == 0) {
            Console.WriteLine("[PASS] StereoToMono rejects odd-length input")
        } else {
            Console.WriteLine("[FAIL] StereoToMono on odd input returned "
                + String_FromInt(badMono.Count()))
        }

        // ═══════════════════════════════════════════════════
        //  v0.8 — lossless splice + native-channel decode + resample
        // ═══════════════════════════════════════════════════

        // ── 38. WavSplice — cut + reorder two ranges ──────────
        // 1000 Hz mono "ramp" (sample i == i) makes each output
        // sample directly traceable back to its source index.
        let rampSr: int = 1000
        var ramp = new List<int>()
        var ri: int = 0
        while (ri < 2000) {
            ramp.Add(ri)
            ri = ri + 1
        }
        let rampPath: string = "/tmp/amc_audio_ramp_test.wav"
        Audio.SaveAsWav(ramp, rampSr, rampPath)

        var spliceSegs = new List<int>()
        spliceSegs.Add(500); spliceSegs.Add(600)   // source [500,600) first
        spliceSegs.Add(100); spliceSegs.Add(200)   // source [100,200) second
        let splicedPath: string = "/tmp/amc_audio_spliced_test.wav"
        let spliceOk: bool = Audio.WavSplice(rampPath, spliceSegs, splicedPath)
        if (spliceOk) {
            Console.WriteLine("[PASS] WavSplice returns true")
        } else {
            Console.WriteLine("[FAIL] WavSplice: " + Audio.LastError())
        }
        let spliced = Audio.LoadWav(splicedPath)
        if (spliced.Count() == 200) {
            Console.WriteLine("[PASS] WavSplice output length = 200")
        } else {
            Console.WriteLine("[FAIL] WavSplice length got "
                + String_FromInt(spliced.Count()))
        }
        let v0: int = spliced.Get(0)
        let v99: int = spliced.Get(99)
        let v100: int = spliced.Get(100)
        let v199: int = spliced.Get(199)
        if (v0 == 500 && v99 == 599 && v100 == 100 && v199 == 199) {
            Console.WriteLine("[PASS] WavSplice content + reorder correct")
        } else {
            Console.WriteLine("[FAIL] WavSplice content: v0=" + String_FromInt(v0)
                + " v99=" + String_FromInt(v99)
                + " v100=" + String_FromInt(v100)
                + " v199=" + String_FromInt(v199))
        }

        // ── 39. LoadNativeChannels — mono stays mono ──────────
        let monoNative = Audio.LoadNativeChannels(rampPath)
        if (monoNative.Count() == 2000) {
            Console.WriteLine("[PASS] LoadNativeChannels mono length")
        } else {
            Console.WriteLine("[FAIL] LoadNativeChannels mono got "
                + String_FromInt(monoNative.Count()))
        }

        // ── 40. LoadNativeChannels — stereo stays interleaved ─
        let nativeStereo = Audio.LoadNativeChannels(stPath)
        if (nativeStereo.Count() == stereoTest.Count()) {
            Console.WriteLine("[PASS] LoadNativeChannels stereo length")
        } else {
            Console.WriteLine("[FAIL] LoadNativeChannels stereo got "
                + String_FromInt(nativeStereo.Count())
                + " expected " + String_FromInt(stereoTest.Count()))
        }

        // ── 41. Resample — upsampling roughly doubles length ──
        let rsSrc = Audio.GenSine(440.0, 0.1, 8000)   // 800 samples @ 8kHz
        let rsOut = Audio.Resample(rsSrc, 8000, 16000)
        let rsLen: int = rsOut.Count()
        if (rsLen == 1600) {
            Console.WriteLine("[PASS] Resample 8k->16k doubles length")
        } else {
            Console.WriteLine("[FAIL] Resample length got " + String_FromInt(rsLen))
        }

        // ── 42. Resample identity (srcRate == dstRate) copies ─
        let rsSame = Audio.Resample(rsSrc, 8000, 8000)
        if (rsSame.Count() == rsSrc.Count() && rsSame.Get(50) == rsSrc.Get(50)) {
            Console.WriteLine("[PASS] Resample identity preserves samples")
        } else {
            Console.WriteLine("[FAIL] Resample identity diverged")
        }

        // ── 43-45. Mp3FrameSplice ──────────────────────────────
        // Fixture (generated by run_tests.sh via ffmpeg/lame, only
        // if both are installed): ~1s @ 300Hz gain 0.1 (quiet)
        // followed by ~1s @ 300Hz gain 0.9 (loud), mono 44100 Hz
        // MP3. Probed rather than assumed present — DurationMsOf
        // returns 0 on a missing/undecodable file, same signal
        // run_tests.sh uses to decide whether to even try
        // generating it.
        let mp3Fixture: string = "/tmp/amc_audio_test_fixture.mp3"
        let haveFixture: bool = Audio.DurationMsOf(mp3Fixture) > 0
        if (!haveFixture) {
            Console.WriteLine("[SKIP] Mp3FrameSplice reorder (no fixture)")
            Console.WriteLine("[SKIP] Mp3FrameSplice full-range (no fixture)")
            Console.WriteLine("[SKIP] Mp3FrameSplice rejects non-MP3 (no fixture)")
        } else {

        // ── 43. Mp3FrameSplice — reorder loud/quiet segments ──
        var mp3Segs = new List<int>()
        mp3Segs.Add(1200); mp3Segs.Add(1800)   // loud region first
        mp3Segs.Add(200);  mp3Segs.Add(800)    // quiet region second
        let mp3OutPath: string = "/tmp/amc_audio_mp3_spliced_test.mp3"
        let mp3SpliceOk: bool = Audio.Mp3FrameSplice(mp3Fixture, mp3Segs, mp3OutPath)
        if (mp3SpliceOk) {
            Console.WriteLine("[PASS] Mp3FrameSplice returns true")
        } else {
            Console.WriteLine("[FAIL] Mp3FrameSplice: " + Audio.LastError())
        }

        let mp3Spliced = Audio.LoadMp3(mp3OutPath)
        let mp3N: int = mp3Spliced.Count()
        if (mp3N > 0) {
            Console.WriteLine("[PASS] Mp3FrameSplice output decodes to non-empty audio")
        } else {
            Console.WriteLine("[FAIL] Mp3FrameSplice output is empty/undecodable")
        }

        // Mean |sample| over first vs second half of the output —
        // loud-then-quiet ordering should show a clear amplitude
        // drop partway through. Survives MP3 lossy compression
        // easily given the ~9x gain ratio between source regions.
        var firstSum: int = 0
        var secondSum: int = 0
        var k: int = 0
        let half: int = mp3N / 2
        while (k < half) {
            var s: int = mp3Spliced.Get(k)
            if (s < 0) { s = 0 - s }
            firstSum = firstSum + s
            k = k + 1
        }
        while (k < mp3N) {
            var s2: int = mp3Spliced.Get(k)
            if (s2 < 0) { s2 = 0 - s2 }
            secondSum = secondSum + s2
            k = k + 1
        }
        let firstAvg: int = firstSum / half
        let secondAvg: int = secondSum / (mp3N - half)
        if (firstAvg > secondAvg * 2) {
            Console.WriteLine("[PASS] Mp3FrameSplice reorder: loud half then quiet half")
        } else {
            Console.WriteLine("[FAIL] Mp3FrameSplice reorder amplitudes: first="
                + String_FromInt(firstAvg) + " second=" + String_FromInt(secondAvg))
        }

        // ── 44. Mp3FrameSplice full-range ≈ same duration ─────
        var mp3FullSeg = new List<int>()
        mp3FullSeg.Add(0); mp3FullSeg.Add(3000)   // past EOF — clamped internally
        let mp3FullPath: string = "/tmp/amc_audio_mp3_full_test.mp3"
        Audio.Mp3FrameSplice(mp3Fixture, mp3FullSeg, mp3FullPath)
        let srcDurMs: int = Audio.DurationMsOf(mp3Fixture)
        let fullDurMs: int = Audio.DurationMsOf(mp3FullPath)
        var durDiff: int = srcDurMs - fullDurMs
        if (durDiff < 0) { durDiff = 0 - durDiff }
        if (durDiff < 100) {
            Console.WriteLine("[PASS] Mp3FrameSplice full-range duration ~ unchanged")
        } else {
            Console.WriteLine("[FAIL] Mp3FrameSplice full-range duration: src="
                + String_FromInt(srcDurMs) + " out=" + String_FromInt(fullDurMs))
        }

        // ── 45. Mp3FrameSplice rejects a non-MP3 source ───────
        var mp3BadSeg = new List<int>()
        mp3BadSeg.Add(0); mp3BadSeg.Add(100)
        let mp3BadOk: bool = Audio.Mp3FrameSplice(rampPath, mp3BadSeg, "/tmp/amc_audio_mp3_bad_test.mp3")
        if (!mp3BadOk) {
            Console.WriteLine("[PASS] Mp3FrameSplice rejects non-MP3 source")
        } else {
            Console.WriteLine("[FAIL] Mp3FrameSplice accepted a WAV as MP3 source")
        }

        }   // end haveFixture

        // ── 46. DenoiseVoice — output length matches input ────
        let noiseSrc = Audio.GenNoise(0.5, 48000)   // 24000 samples @ 48kHz
        let denoised = Audio.DenoiseVoice(noiseSrc)
        if (denoised.Count() == noiseSrc.Count()) {
            Console.WriteLine("[PASS] DenoiseVoice output length matches input")
        } else {
            Console.WriteLine("[FAIL] DenoiseVoice length: got "
                + String_FromInt(denoised.Count())
                + " expected " + String_FromInt(noiseSrc.Count()))
        }

        // ── 47. DenoiseVoice measurably attenuates broadband noise ─
        // RNNoise is trained on speech+noise, but pure white noise
        // (no speech to preserve) should still come out attenuated
        // — a simple, device-independent sanity check that the
        // model is actually running rather than passing audio
        // through untouched.
        var noiseSum: int = 0
        var denSum: int = 0
        var di: int = 0
        let dn: int = denoised.Count()
        while (di < dn) {
            var a: int = noiseSrc.Get(di)
            if (a < 0) { a = 0 - a }
            noiseSum = noiseSum + a
            var b: int = denoised.Get(di)
            if (b < 0) { b = 0 - b }
            denSum = denSum + b
            di = di + 1
        }
        if (denSum < noiseSum) {
            Console.WriteLine("[PASS] DenoiseVoice reduces broadband noise energy")
        } else {
            Console.WriteLine("[FAIL] DenoiseVoice: noiseAvg="
                + String_FromInt(noiseSum / dn) + " denoisedAvg="
                + String_FromInt(denSum / dn))
        }

        // ── 48. DenoiseVoice on empty buffer returns empty ────
        let emptyBuf = new List<int>()
        let emptyDenoised = Audio.DenoiseVoice(emptyBuf)
        if (emptyDenoised.Count() == 0) {
            Console.WriteLine("[PASS] DenoiseVoice on empty buffer returns empty")
        } else {
            Console.WriteLine("[FAIL] DenoiseVoice empty input returned "
                + String_FromInt(emptyDenoised.Count()))
        }

        // ── 49. SaveAsOpusMono — writes a valid Ogg container ──
        // No decode round-trip check here: this package has no
        // Opus decoder wired up on the Amalgame side (miniaudio
        // doesn't decode Opus — its bundled decoders are MP3/FLAC/
        // Vorbis only, a different codec family). Verified instead
        // at the container level: a real Ogg file always starts
        // with the "OggS" capture pattern (RFC 3533) — catches
        // "wrote garbage/nothing" bugs without needing a full
        // decoder. The actual opus_encode() call path was already
        // validated end-to-end manually before vendoring (see
        // amalgame.toml's [stdlib] comment history / dev notes).
        let opusSrc = Audio.GenSine(440.0, 0.3, 48000)   // 14400 samples
        let opusMonoPath: string = "/tmp/amc_audio_opus_mono_test.opus"
        let opusMonoOk: bool = Audio.SaveAsOpusMono(opusSrc, 48000, opusMonoPath)
        if (opusMonoOk) {
            Console.WriteLine("[PASS] SaveAsOpusMono returns true")
        } else {
            Console.WriteLine("[FAIL] SaveAsOpusMono: " + Audio.LastError())
        }
        let opusMonoRaw: string = File.ReadAll(opusMonoPath)
        if (String_Length(opusMonoRaw) >= 4 && String_Substring(opusMonoRaw, 0, 4) == "OggS") {
            Console.WriteLine("[PASS] SaveAsOpusMono output starts with OggS")
        } else {
            Console.WriteLine("[FAIL] SaveAsOpusMono output missing OggS magic")
        }

        // ── 50. SaveAsOpusStereo — writes a valid Ogg container ─
        let opusStereoSrc = Audio.MonoToStereo(opusSrc)
        let opusStereoPath: string = "/tmp/amc_audio_opus_stereo_test.opus"
        let opusStereoOk: bool = Audio.SaveAsOpusStereo(opusStereoSrc, 48000, opusStereoPath)
        if (opusStereoOk) {
            Console.WriteLine("[PASS] SaveAsOpusStereo returns true")
        } else {
            Console.WriteLine("[FAIL] SaveAsOpusStereo: " + Audio.LastError())
        }
        let opusStereoRaw: string = File.ReadAll(opusStereoPath)
        if (String_Length(opusStereoRaw) >= 4 && String_Substring(opusStereoRaw, 0, 4) == "OggS") {
            Console.WriteLine("[PASS] SaveAsOpusStereo output starts with OggS")
        } else {
            Console.WriteLine("[FAIL] SaveAsOpusStereo output missing OggS magic")
        }

        // ── 51. SaveAsOpus rejects a non-48000 sample rate ────
        let opusBadSrc = Audio.GenSine(440.0, 0.1, 44100)
        let opusBadOk: bool = Audio.SaveAsOpusMono(opusBadSrc, 44100, "/tmp/amc_audio_opus_bad_test.opus")
        if (!opusBadOk) {
            Console.WriteLine("[PASS] SaveAsOpus rejects non-48000 sample rate")
        } else {
            Console.WriteLine("[FAIL] SaveAsOpus accepted 44100Hz")
        }
    }
}
